#!/bin/bash
# Start a flux instance in this container with the coscheduling stack
# configured the way the terraform cluster configures it: fluxion with the
# coschedule queue policy, the quantum jobtap plugin loaded from the
# job-manager config, and the vendor devices populated into the graph before
# any job runs. The instance's initial program is flux-quantum-init, which
# populates and then runs your command, or an interactive shell.
#
#   flux-quantum-start                      one broker, a shell inside
#   flux-quantum-start -s 2                 two brokers, the pair can split
#   flux-quantum-start -- flux-quantum-demo mock
#
# Tuning, all optional:
#   TOTAL_CORES    cores the jobtap plugin budgets pairs against, nproc
#   RESERVE_CORES  cores kept back from pairs, 0
#   PREEMPT_AFTER  seconds before an unprotected job is cancelled to make
#                  room. Unset means never, which is the safe default
#   VENDORS        comma separated allow list for the jobtap plugin, and
#                  what gets populated into the graph: ibm,mock,braket,ionq
#   QPUS           qpu vertices per vendor, the concurrency limit, 2
set -eu

usage() { sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; }

SIZE=1
while [ $# -gt 0 ]; do
    case "$1" in
        -s) SIZE=$2; shift 2 ;;
        -s*) SIZE=${1#-s}; shift ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        *) break ;;
    esac
done

TOTAL_CORES=${TOTAL_CORES:-$(nproc)}
RESERVE_CORES=${RESERVE_CORES:-0}
VENDORS=${VENDORS:-ibm,mock,braket,ionq}
JOBTAP=${FLUX_QUANTUM_JOBTAP:-/etc/flux/system/jobtap/quantum.so}
CONFDIR=${FLUX_QUANTUM_CONFDIR:-$HOME/.flux-quantum/conf.d}

preempt=""
if [ -n "${PREEMPT_AFTER:-}" ]; then
    preempt=", preempt_after = ${PREEMPT_AFTER}"
fi

mkdir -p "$CONFDIR"
cat > "$CONFDIR/coschedule.toml" <<TOML
# Generated by flux-quantum-start. The same two tables the terraform
# start-script writes to /etc/flux/system/conf.d/coschedule.toml.

# Reserve for held jobs. Under fcfs a held job is skipped and never reserves,
# which is the one policy where coscheduling silently does not work.
[sched-fluxion-qmanager]
queue-policy = "coschedule"

# Admission control. A pair reserves its cores plus one for the scout, and a
# pair that would exceed the budget is rejected at submit rather than admitted
# and left waiting with a vendor session already open.
[job-manager]
plugins = [
  { load = "${JOBTAP}", conf = { vendors = "${VENDORS}", protect_types = "qpu", total_cores = ${TOTAL_CORES}, reserve_cores = ${RESERVE_CORES}${preempt} } }
]
TOML

[ -f "$JOBTAP" ] || echo "WARNING $JOBTAP is missing, admission control will be absent" >&2

export VENDORS QPUS="${QPUS:-2}"
echo "flux-quantum-start: $SIZE broker(s), config in $CONFDIR, vendors $VENDORS" >&2
exec flux start --config-path="$CONFDIR" -s "$SIZE" flux-quantum-init "$@"
