# QRMI credentials for one IBM resource.
# Copy to .env, fill in, then chmod 600 .env
#
# These comes from the IBM Quantum Platform console. SERVICE_CRN is the CRN of
# your instance and IAM_APIKEY is an IBM Cloud API key.

ibm_kingston_QRMI_IBM_QRS_ENDPOINT=https://quantum.cloud.ibm.com/api/v1
ibm_kingston_QRMI_IBM_QRS_IAM_ENDPOINT=https://iam.cloud.ibm.com
ibm_kingston_QRMI_IBM_QRS_IAM_APIKEY=REPLACE_ME
ibm_kingston_QRMI_IBM_QRS_SERVICE_CRN=REPLACE_ME

# Optional. batch or dedicated. QRMI defaults this when unset.
# ibm_kingston_QRMI_IBM_QRS_SESSION_MODE=batch

# For a direct access system use the QS prefix and
# --quantum-ibm-type ibm-quantum-system instead:
#
# ibm_kingston_QRMI_IBM_QS_ENDPOINT=
# ibm_kingston_QRMI_IBM_QS_IAM_ENDPOINT=https://iam.cloud.ibm.com
# ibm_kingston_QRMI_IBM_QS_IAM_APIKEY=
# ibm_kingston_QRMI_IBM_QS_SERVICE_CRN=
